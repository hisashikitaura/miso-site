# Firebase web config for the "Miso Site" web app in project kith-diary.
# Get it with: firebase apps:sdkconfig WEB <appId> --project kith-diary
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional: App Check (reCAPTCHA v3/Enterprise site key). Leave empty to disable.
VITE_RECAPTCHA_SITE_KEY=
